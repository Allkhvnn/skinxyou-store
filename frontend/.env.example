# Copy to .env.local. Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format without "+" (used in wa.me links).
NEXT_PUBLIC_WHATSAPP_PHONE=77760050625

# Backend base URL for server-side rendering (not exposed to the browser).
API_BASE_URL=http://localhost:8080

# Public backend URL the browser uses for cart quotes and placing orders.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

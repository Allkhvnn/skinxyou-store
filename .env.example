# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=skinxyou
POSTGRES_USER=skinxyou
POSTGRES_PASSWORD=change-me
# 5433 to avoid clashing with a locally installed PostgreSQL on 5432
POSTGRES_PORT=5433

# BILLZ integration key (Settings → Company → Integration keys). Keep secret.
BILLZ_SECRET_TOKEN=

# Telegram bot for new order notifications (token from @BotFather). Keep secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel. JWT secret: 32+ random characters (required in production).
ADMIN_JWT_SECRET=
# First admin account, created once when no staff accounts exist (password: 10+ characters).
# Spring reads this file as .properties (ISO-8859-1): write non-Latin text as \uXXXX escapes here.
# Real environment variables in production have no such limitation.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
